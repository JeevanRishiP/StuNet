# apps/web — Student & Guest Portal
# Copy to .env.local and fill in real values.
#
# ── Port Map (conflict-free with other local projects) ───────────────────────
#   This app runs on       → http://localhost:3010
#   Postgres (StuNet)      → localhost:5434
#   Redis    (StuNet)      → localhost:6382
#   MinIO    (StuNet)      → http://localhost:9010
#   Mailhog  (StuNet)      → smtp://localhost:1026  UI: http://localhost:8026
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app_service_role:app_localdev_CHANGE_ME@localhost:5434/stunet
REDIS_URL=redis://localhost:6382
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=stunet-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_CHANGE_ME
AUTH_SECRET=CHANGE_ME_at_least_32_chars_random_string
NEXTAUTH_URL=http://localhost:3010
