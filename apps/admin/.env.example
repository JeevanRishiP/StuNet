# apps/admin — Admin Portal
# IMPORTANT: This app connects with admin_service_role which has ZERO
# access to user_private_details. Never replace this with app_service_role.
DATABASE_URL=postgresql://admin_service_role:admin_localdev_CHANGE_ME@localhost:5432/stunet

# AUTH_DATABASE_URL — MUST use app_service_role (or owner) so NextAuth can
# read auth_credentials and auth_sessions during login.
# DO NOT use admin_service_role here — it cannot read those tables.
AUTH_DATABASE_URL=postgresql://app_service_role:app_localdev_CHANGE_ME@localhost:5432/stunet

REDIS_URL=redis://localhost:6379
AUTH_SECRET=CHANGE_ME_at_least_32_chars_random_string
NEXTAUTH_URL=http://localhost:3001
MFA_ISSUER_NAME=StuNet Admin
