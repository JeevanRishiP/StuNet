# apps/admin — Admin Portal
# IMPORTANT: DATABASE_URL uses admin_service_role — ZERO access to user_private_details.
# AUTH_DATABASE_URL MUST use app_service_role so NextAuth can read auth tables.
#
# ── Port Map (conflict-free with other local projects) ───────────────────────
#   This app runs on       → http://localhost:3011
#   Postgres (StuNet)      → localhost:5434
#   Redis    (StuNet)      → localhost:6382
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://admin_service_role:admin_localdev_CHANGE_ME@localhost:5434/stunet
AUTH_DATABASE_URL=postgresql://app_service_role:app_localdev_CHANGE_ME@localhost:5434/stunet
REDIS_URL=redis://localhost:6382
AUTH_SECRET=CHANGE_ME_at_least_32_chars_random_string
NEXTAUTH_URL=http://localhost:3011
MFA_ISSUER_NAME=StuNet Admin
