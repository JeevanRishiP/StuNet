# Root .env.example — see per-app env files below.
# Copy each block to the corresponding app:
#   apps/web/.env.local     <- app (student portal)
#   apps/admin/.env.local   <- admin (admin portal only)
#   apps/worker/.env.local  <- worker (BullMQ jobs)
# NEVER place all secrets in one shared .env — each app/container
# should only have the credentials it actually needs.

# ── apps/web ───────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://app_service_role:CHANGE_ME@localhost:5432/stunet
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=stunet-media
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# AUTH_SECRET=CHANGE_ME_min_32_chars
# NEXTAUTH_URL=http://localhost:3000

# ── apps/admin ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://admin_service_role:CHANGE_ME@localhost:5432/stunet
# REDIS_URL=redis://localhost:6379
# AUTH_SECRET=CHANGE_ME_min_32_chars
# NEXTAUTH_URL=http://localhost:3001
# MFA_ISSUER_NAME=StuNet Admin

# ── apps/worker ────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://app_service_role:CHANGE_ME@localhost:5432/stunet
# REDIS_URL=redis://localhost:6379
# CODEFORCES_API_RATE_LIMIT_PER_MIN=20
# GITHUB_API_RATE_LIMIT_PER_MIN=60
# LEETCODE_API_RATE_LIMIT_PER_MIN=10
