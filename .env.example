# StuNet Root Environment Template
# Copy to individual apps:
#   apps/web/.env.local
#   apps/admin/.env.local
#   apps/worker/.env.local
#
# Ports configured to avoid conflicts with AI WhatsApp Agent (5432, 6379, 8080, 3001)
# and DineFlow (5433, 6380, 9000, 9001, 1025, 8025, 3000, 3003, 3004).

# --- apps/web (runs on port 3010) ---
# DATABASE_URL=postgresql://app_service_role:CHANGE_ME@localhost:5434/stunet
# REDIS_URL=redis://localhost:6382
# S3_ENDPOINT=http://localhost:9010
# S3_BUCKET=stunet-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=CHANGE_ME
# AUTH_SECRET=CHANGE_ME_at_least_32_chars
# NEXTAUTH_URL=http://localhost:3010

# --- apps/admin (runs on port 3011) ---
# DATABASE_URL=postgresql://admin_service_role:CHANGE_ME@localhost:5434/stunet
# AUTH_DATABASE_URL=postgresql://app_service_role:CHANGE_ME@localhost:5434/stunet
# REDIS_URL=redis://localhost:6382
# AUTH_SECRET=CHANGE_ME_at_least_32_chars
# NEXTAUTH_URL=http://localhost:3011
# MFA_ISSUER_NAME="StuNet Admin"

# --- apps/worker ---
# DATABASE_URL=postgresql://app_service_role:CHANGE_ME@localhost:5434/stunet
# REDIS_URL=redis://localhost:6382
# LOG_LEVEL=info
