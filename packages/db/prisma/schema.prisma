enum CompanyOwnerType {
  FOUNDER
  CO_FOUNDER
  FOUNDING_MEMBER
  EMPLOYEE
  ADVISOR

  @@map("company_owner_type")
}

model Company {
  id                   String            @id @default(cuid())
  name                 String            @db.VarChar(200)
  normalizedName       String            @unique @map("normalized_name") @db.VarChar(200)
  description          String?           @db.Text
  tagline              String?           @db.VarChar(300)
  logoUrl              String?           @map("logo_url") @db.VarChar(2000)
  websiteUrl           String?           @map("website_url") @db.VarChar(2000)
  linkedinUrl          String?           @map("linkedin_url") @db.VarChar(2000)
  stage                String            @default("IDEA") @db.VarChar(50)
  verifiedRevenue      Float             @default(0) @map("verified_revenue")
  revenueCurrency      String            @default("INR") @map("revenue_currency") @db.VarChar(10)
  isRevenueVerified    Boolean           @default(false) @map("is_revenue_verified")
  verificationProofUrl String?           @map("verification_proof_url") @db.VarChar(2000)
  hiringStatus         Boolean           @default(false) @map("hiring_status")
  createdByUserId      String            @map("created_by_user_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at")

  roles            UserCompanyRole[]
  followers        CompanyFollow[]
  posts            Post[]
  opportunities    InitiativeOpportunity[]
  interestRequests InitiativeInterestRequest[]

  @@map("companies")
}

model UserCompanyRole {
  userId        String           @map("user_id")
  companyId     String           @map("company_id")
  ownerType     CompanyOwnerType @map("owner_type")
  position      String?          @db.VarChar(100)
  showOnProfile Boolean          @default(true) @map("show_on_profile")
  createdAt     DateTime         @default(now()) @map("created_at")

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company_roles")
}

model OpenSourceProject {
  id                    String            @id @default(cuid())
  ownerUserId           String            @map("owner_user_id")
  name                  String            @db.VarChar(200)
  description           String?           @db.Text
  tagline               String?           @db.VarChar(300)
  logoUrl               String?           @map("logo_url") @db.VarChar(2000)
  githubUrl             String            @map("github_url") @db.VarChar(2000)
  syncedStars           Int?              @map("synced_stars")
  starsCount            Int               @default(0) @map("stars_count")
  contributorsCount     Int               @default(1) @map("contributors_count")
  forksCount            Int               @default(0) @map("forks_count")
  primaryLanguage       String?           @map("primary_language") @db.VarChar(50)
  license               String?           @db.VarChar(50)
  isOpenForContributors Boolean           @default(true) @map("is_open_for_contributors")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  owner         UserIdentity            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  links         ProjectLink[]
  members          ProjectMember[]
  followers        ProjectFollow[]
  posts            Post[]
  opportunities    InitiativeOpportunity[]
  interestRequests InitiativeInterestRequest[]

  @@index([ownerUserId])
  @@map("open_source_projects")
}

model ProjectLink {
  id        String @id @default(cuid())
  projectId String @map("project_id")
  name      String @db.VarChar(100)
  url       String @db.VarChar(2000)

  project OpenSourceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_links")
}

enum ProjectMemberRole {
  MAINTAINER
  CORE_CONTRIBUTOR
  CONTRIBUTOR

  @@map("project_member_role")
}

model ProjectMember {
  userId    String            @map("user_id")
  projectId String            @map("project_id")
  role      ProjectMemberRole @default(CONTRIBUTOR)
  position  String?           @db.VarChar(100)
  createdAt DateTime          @default(now()) @map("created_at")

  project OpenSourceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    UserIdentity      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

model CompanyFollow {
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("company_follows")
}

model ProjectFollow {
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    UserIdentity      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project OpenSourceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_follows")
}

enum OpportunityRoleType {
  CO_FOUNDER
  FOUNDING_MEMBER
  FULL_TIME
  PART_TIME
  INTERN
  CONTRIBUTOR

  @@map("opportunity_role_type")
}

model InitiativeOpportunity {
  id           String              @id @default(cuid())
  companyId    String?             @map("company_id")
  projectId    String?             @map("project_id")
  creatorId    String              @map("creator_id")
  title        String              @db.VarChar(200)
  roleType     OpportunityRoleType @map("role_type")
  description  String              @db.Text
  skills       String[]            @default([])
  compensation String?             @db.VarChar(200)
  contactEmail String?             @map("contact_email") @db.VarChar(255)
  applyUrl     String?             @map("apply_url") @db.VarChar(2000)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at")

  company Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project OpenSourceProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator UserIdentity       @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([creatorId])
  @@map("initiative_opportunities")
}

model InitiativeInterestRequest {
  id           String   @id @default(cuid())
  companyId    String?  @map("company_id")
  projectId    String?  @map("project_id")
  userId       String   @map("user_id")
  interestType String   @default("TEAM_MEMBER") @map("interest_type") @db.VarChar(50)
  message      String?  @db.Text
  email        String?  @db.VarChar(255)
  status       String   @default("PENDING") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  company Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project OpenSourceProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    UserIdentity       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([userId])
  @@map("initiative_interest_requests")
}

enum PlatformEventMode {
  ONLINE
  OFFLINE

  @@map("platform_event_mode")
}

enum PlatformEventType {
  HACKATHON
  COMPETITION
  WORKSHOP
  MEETUP

  @@map("platform_event_type")
}

model PlatformEvent {
  id                   String            @id @default(cuid())
  organizerUserId      String            @map("organizer_user_id")
  mode                 PlatformEventMode
  type                 PlatformEventType
  name                 String            @db.VarChar(200)
  description          String?           @db.Text
  eventDate            DateTime          @map("event_date")
  registrationDeadline DateTime?         @map("registration_deadline")
  location             String?           @db.VarChar(500)
  createdAt            DateTime          @default(now()) @map("created_at")

  organizer UserIdentity @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)

  @@index([organizerUserId])
  @@index([eventDate])
  @@map("events")
}

model ProfessionalInvite {
  id                   String    @id @default(cuid())
  creatorUserId        String    @map("creator_user_id")
  mode                 String    @db.VarChar(50)
  type                 String    @db.VarChar(50)
  requirements         String?   @db.Text
  name                 String    @db.VarChar(200)
  description          String?   @db.Text
  eventDate            DateTime? @map("event_date")
  registrationDeadline DateTime? @map("registration_deadline")
  location             String?   @db.VarChar(500)
  recipientUserId      String?   @map("recipient_user_id")
  isDirectInvite       Boolean   @default(false) @map("is_direct_invite")
  expiresAt            DateTime? @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  creator   UserIdentity  @relation("CreatedInvites", fields: [creatorUserId], references: [id], onDelete: Cascade)
  recipient UserIdentity? @relation("ReceivedInvites", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([creatorUserId])
  @@index([recipientUserId])
  @@map("professional_invites")
}

enum GroupJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("group_join_request_status")
}

model GroupJoinRequest {
  id        String                 @id @default(cuid())
  groupId   String                 @map("group_id")
  userId    String                 @map("user_id")
  purpose   String?                @db.Text
  status    GroupJoinRequestStatus @default(PENDING)
  createdAt DateTime               @default(now()) @map("created_at")

  group Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([userId])
  @@map("group_join_requests")
}

enum ResourceCategory {
  GITHUB_REPO
  BLOG
  RESEARCH_PAPER
  NEWS_ARTICLE

  @@map("resource_category")
}

model UsefulResource {
  id              String           @id @default(cuid())
  createdByUserId String           @map("created_by_user_id")
  category        ResourceCategory
  title           String           @db.VarChar(300)
  url             String?          @db.VarChar(2000)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")

  creator UserIdentity @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
  @@map("resources")
}

enum TaggableType {
  POST
  POLL
  EVENT
  COMPANY
  PROJECT
  RESOURCE

  @@map("taggable_type")
}

model Tag {
  id        String     @id @default(cuid())
  label     String     @unique @db.VarChar(100)
  taggables Taggable[]

  @@map("tags")
}

model Taggable {
  tagId        String       @map("tag_id")
  taggableType TaggableType @map("taggable_type")
  taggableId   String       @map("taggable_id")

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, taggableType, taggableId])
  @@index([taggableType, taggableId])
  @@map("taggables")
}

model PostLike {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@index([postId, createdAt])
  @@map("post_likes")
}

model PostComment {
  id              String   @id @default(cuid())
  postId          String   @map("post_id")
  userId          String   @map("user_id")
  parentCommentId String?  @map("parent_comment_id")
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    UserIdentity  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("PostCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  @@index([postId, createdAt])
  @@index([userId])
  @@map("post_comments")
}

model PostView {
  postId        String   @map("post_id")
  userId        String   @map("user_id")
  firstViewedAt DateTime @default(now()) @map("first_viewed_at")
  lastViewedAt  DateTime @default(now()) @map("last_viewed_at")
  viewCount     Int      @default(1) @map("view_count")

  post Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_views")
}

// ─────────────────────────────────────────────
// Feed Ranking System v2 Models (Section 3)
// ─────────────────────────────────────────────

model FeedImpression {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  postId        String   @map("post_id")
  rankPosition  Int      @map("rank_position")
  sessionId     String   @map("session_id")
  variant       String   @default("CONTROL") @map("variant")
  isExploration Boolean  @default(false) @map("is_exploration")
  shownAt       DateTime @default(now()) @map("shown_at")

  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([shownAt, userId, postId], name: "feed_impressions_training_idx")
  @@index([sessionId])
  @@index([userId, shownAt])
  @@index([postId, shownAt])
  @@index([variant, shownAt])
  @@map("feed_impressions")
}

model AuthorEngagementStats {
  authorUserId          String   @id @map("author_user_id")
  avgLikesPerPost30d    Decimal? @map("avg_likes_per_post_30d") @db.Decimal(10, 4)
  avgCommentsPerPost30d Decimal? @map("avg_comments_per_post_30d") @db.Decimal(10, 4)
  postCount30d          Int      @default(0) @map("post_count_30d")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  author UserIdentity @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@map("author_engagement_stats")
}

model UserAuthorAffinity {
  viewerUserId  String   @map("viewer_user_id")
  authorUserId  String   @map("author_user_id")
  affinityScore Decimal  @default(0) @map("affinity_score") @db.Decimal(10, 4)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  viewer UserIdentity @relation("UserAffinityViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  author UserIdentity @relation("UserAffinityAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@id([viewerUserId, authorUserId])
  @@index([authorUserId])
  @@index([viewerUserId])
  @@map("user_author_affinity")
}

model FeedModelVersion {
  id                   String   @id @default(cuid())
  trainedAt            DateTime @default(now()) @map("trained_at")
  modelType            String   @default("LOGISTIC_REGRESSION") @map("model_type")
  coefficientsJson     Json     @map("coefficients_json")
  trainingExampleCount Int      @map("training_example_count")
  validationAuc        Decimal? @map("validation_auc") @db.Decimal(6, 4)
  isActive             Boolean  @default(false) @map("is_active")

  @@index([isActive])
  @@map("feed_model_versions")
}
