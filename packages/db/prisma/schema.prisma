  severity   AlertSeverity @default(INFO)
  expiresAt  DateTime?     @map("expires_at")
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")

  campus     Campus @relation(fields: [campusId], references: [id])

  @@index([campusId, isActive, createdAt(sort: Desc)])
  @@map("campus_live_alerts")
}

model CampusCiaSchedule {
  id          String   @id @default(cuid())
  campusId    String   @map("campus_id")
  createdById String   @map("created_by_id")
  subject     String   @db.VarChar(200)
  component   String   @db.VarChar(100) // e.g. "CIA-1", "CIA-2", "Model"
  scheduledAt DateTime @map("scheduled_at")
  venue       String?  @db.VarChar(200)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus      Campus @relation(fields: [campusId], references: [id])

  @@index([campusId, scheduledAt])
  @@map("campus_cia_schedules")
}

model CampusIaExam {
  id          String   @id @default(cuid())
  campusId    String   @map("campus_id")
  createdById String   @map("created_by_id")
  subject     String   @db.VarChar(200)
  examType    String   @db.VarChar(100) // e.g. "IA-1", "IA-2", "End Semester"
  scheduledAt DateTime @map("scheduled_at")
  durationMins Int?    @map("duration_mins")
  venue       String?  @db.VarChar(200)
  syllabusUrl String?  @map("syllabus_url") @db.VarChar(500)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus      Campus @relation(fields: [campusId], references: [id])

  @@index([campusId, scheduledAt])
  @@map("campus_ia_exams")
}

model CampusCalendar {
  id          String   @id @default(cuid())
  campusId    String   @map("campus_id")
  createdById String   @map("created_by_id")
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  eventDate   DateTime @map("event_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  eventType   String   @db.VarChar(100) // e.g. "holiday", "fest", "workshop"
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus      Campus @relation(fields: [campusId], references: [id])

  @@index([campusId, eventDate])
  @@map("campus_calendars")
}

