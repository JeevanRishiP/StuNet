// ============================================================
// StuNet Prisma Schema — Phase 1
// Build order matches Section 6 of the build instructions:
//   1.  campuses, clubs
//   2.  user_identity, user_private_details
//   3.  connections, user_blocks
//   4.  posts, groups, group_members
//   5.  achievements, achievement_rankings, brave_metrics
//   6.  club_members, club_role_assignments, suggestion_windows,
//       suggestions, suggestion_votes
//   7.  campus_live_alerts, campus_cia_schedules,
//       campus_ia_exams, campus_calendars
//   8.  campus_market_listings, campus_market_images
//   9.  notifications, notification_preferences
//  10.  reports, data_deletion_requests,
//       pending_bulk_actions, admin_audit_logs
//  11.  (materialized view created via raw SQL in migration 011)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  GUEST
  STUDENT
  FACULTY
  ALUMNI
  CLUB_MANAGER
  CAMPUS_MANAGER
  SUPER_ADMIN

  @@map("user_role")
}

enum RosterRole {
  STUDENT
  FACULTY
  ALUMNI

  @@map("roster_role")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("connection_status")
}

enum PostVisibility {
  PUBLIC // visible to all including guests
  CONNECTIONS // only connected students
  CAMPUS // only verified students of same campus

  @@map("post_visibility")
}

enum PostType {
  TEXT
  IMAGE
  LINK
  POLL

  @@map("post_type")
}

enum GroupType {
  OPEN // any verified student can join
  CLOSED // request to join; admin approves
  SECRET // invite-only, hidden from directory

  @@map("group_type")
}

enum GroupMemberRole {
  MEMBER
  MODERATOR
  ADMIN

  @@map("group_member_role")
}

enum AchievementCategory {
  COMPETITIVE_PROGRAMMING
  OPEN_SOURCE
  RESEARCH
  HACKATHON
  CERTIFICATION
  SPORTS
  CULTURAL
  ACADEMIC
  OTHER

  @@map("achievement_category")
}

enum AchievementScope {
  CAMPUS
  INTER_COLLEGE
  STATE
  NATIONAL
  INTERNATIONAL

  @@map("achievement_scope")
}

enum AchievementVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("achievement_verification_status")
}

enum ClubMemberRole {
  MEMBER
  PRESIDENT
  VICE_PRESIDENT
  OPERATIONAL_HEAD
  OUTREACH_HEAD
  FINANCE_HEAD
  CREATIVE_DESIGN_HEAD
  SOCIAL_MEDIA_HEAD
  MANAGER

  @@map("club_member_role")
}

enum MarketListingStatus {
  ACTIVE
  SOLD
  FLAGGED
  REMOVED

  @@map("market_listing_status")
}

enum MarketListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR

  @@map("market_listing_condition")
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  NEW_FOLLOWER
  POST_LIKE
  POST_COMMENT
  ACHIEVEMENT_VERIFIED
  ACHIEVEMENT_REJECTED
  CLUB_INVITE
  CLUB_ROLE_ASSIGNED
  CLUB_ROLE_REVOKED
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  SUGGESTION_VOTE
  LIVE_ALERT
  MARKET_INTEREST
  REPORT_RESOLVED
  SYSTEM

  @@map("notification_type")
}

enum PollSubmissionMode {
  SINGLE_SUBMIT
  MULTIPLE_SUBMIT

  @@map("poll_submission_mode")
}

enum ReportContentType {
  POST
  COMMENT
  USER_PROFILE
  CLUB
  GROUP
  MARKET_LISTING
  POLL_ENTRY

  @@map("report_content_type")
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_ACTION
  DISMISSED

  @@map("report_status")
}

enum BulkActionType {
  BULK_VERIFY_ACHIEVEMENTS
  BULK_REMOVE_POSTS
  BULK_BAN_USERS
  BULK_ASSIGN_CLUB_ROLE

  @@map("bulk_action_type")
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("alert_severity")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED

  @@map("deletion_request_status")
}

enum ContactVisibility {
  PUBLIC
  CONNECTIONS
  CAMPUS
  ONLY_ME

  @@map("contact_visibility")
}

// ─────────────────────────────────────────────
// 1. CAMPUSES & CLUBS
// ─────────────────────────────────────────────

model Campus {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(200)
  universityName String?  @map("university_name") @db.VarChar(200)
  slug           String   @unique @db.VarChar(100)
  emailDomain    String?  @map("email_domain") @db.VarChar(100)
  city           String   @db.VarChar(100)
  state          String   @db.VarChar(100)
  country        String   @default("India") @db.VarChar(100)
  address        String?  @db.VarChar(500)
  facilities     String[] @default([])
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  websiteUrl     String?  @map("website_url") @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  clubs          Club[]
  faculties      CampusFaculty[]
  userIdentities UserIdentity[]
  liveAlerts     CampusLiveAlert[]
  ciaSchedules   CampusCiaSchedule[]
  iaExams        CampusIaExam[]
  calendars      CampusCalendar[]
  marketListings CampusMarketListing[]
  campusManagers UserIdentity[]        @relation("CampusManager")
  rosterEntries  InstitutionalRoster[]
  batches        CampusBatch[]
  subjects       SemesterSubject[]
  polls          Poll[]

  @@index([emailDomain])
  @@index([slug])
  @@index([state, city])
  @@map("campuses")
}

model CampusFaculty {
  id          String   @id @default(cuid())
  campusId    String   @map("campus_id")
  employeeId  String?  @map("employee_id") @db.VarChar(100)
  name        String   @db.VarChar(150)
  designation String   @db.VarChar(150)
  department  String   @db.VarChar(150)
  category    String   @default("TEACHING") @db.VarChar(50) // TEACHING, NON_TEACHING, HOD, MENTOR, SUCCESS_COACH
  email       String?  @db.VarChar(254)
  phone       String?  @db.VarChar(20)
  officeRoom  String?  @map("office_room") @db.VarChar(100)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
  @@index([employeeId])
  @@map("campus_faculties")
}

model CampusBatch {
  id                     String   @id @default(cuid())
  campusId               String   @map("campus_id")
  year                   Int // e.g. 2023, 2024, 2025, 2026, 2027
  currentYear            Int?     @default(1) @map("current_year")
  currentSemester        Int?     @default(1) @map("current_semester")
  numberOfStudents       Int?     @map("number_of_students")
  numberOfSections       Int?     @map("number_of_sections")
  sections               String[] @default([])
  degree                 String?  @db.VarChar(200) // e.g. "B.Tech Computer Science & AI"
  successCoachEmployeeId String?  @map("success_coach_employee_id") @db.VarChar(100)
  successCoachName       String?  @map("success_coach_name") @db.VarChar(150)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([campusId, year])
  @@index([campusId])
  @@map("campus_batches")
}

model SemesterSubject {
  id                   String   @id @default(cuid())
  campusId             String   @map("campus_id")
  batchYear            Int      @map("batch_year")
  semester             Int // 1 to 8
  name                 String   @db.VarChar(200)
  code                 String?  @db.VarChar(50)
  credits              Int?     @default(3)
  type                 String   @default("Theory") @db.VarChar(50) // Theory, Practical
  handledBy            String   @default("University") @map("handled_by") @db.VarChar(50) // University, NIAT
  hodEmployeeId        String?  @map("hod_employee_id") @db.VarChar(100)
  hodName              String?  @map("hod_name") @db.VarChar(150)
  teachingFacultyIds   String[] @default([]) @map("teaching_faculty_ids")
  teachingFacultyNames String[] @default([]) @map("teaching_faculty_names")
  mentorFacultyIds     String[] @default([]) @map("mentor_faculty_ids")
  mentorFacultyNames   String[] @default([]) @map("mentor_faculty_names")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId, batchYear, semester])
  @@map("semester_subjects")
}

model Club {
  id                 String   @id @default(cuid())
  campusId           String   @map("campus_id")
  name               String   @db.VarChar(200)
  slug               String   @db.VarChar(100)
  description        String   @db.Text
  category           String   @db.VarChar(100)
  // Institutional contact only — personal contact never stored here
  institutionalEmail String?  @map("institutional_email") @db.VarChar(254)
  institutionalPhone String?  @map("institutional_phone") @db.VarChar(20)
  instagramUrl       String?  @map("instagram_url") @db.VarChar(500)
  logoUrl            String?  @map("logo_url") @db.VarChar(500)
  bannerUrl          String?  @map("banner_url") @db.VarChar(500)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  campus            Campus               @relation(fields: [campusId], references: [id])
  members           ClubMember[]
  roleAssignments   ClubRoleAssignment[]
  suggestionWindows SuggestionWindow[]
  posts             Post[]

  @@unique([campusId, slug])
  @@index([campusId])
  @@map("clubs")
}

// ─────────────────────────────────────────────
// 2. USER IDENTITY & PRIVATE DETAILS
// SECURITY: These two tables are NEVER collapsed.
// admin_service_role has ZERO access to user_private_details.
// ─────────────────────────────────────────────

model UserIdentity {
  id                 String             @id @default(cuid())
  campusId           String?            @map("campus_id")
  managedCampusId    String?            @map("managed_campus_id") // for CAMPUS_MANAGER scope
  role               UserRole           @default(STUDENT)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  isVerified         Boolean            @default(true) @map("is_verified")
  displayName        String             @map("display_name") @db.VarChar(60)
  username           String             @unique @db.VarChar(40)
  studentEmail       String?            @unique @map("student_email") @db.VarChar(254)
  avatarUrl          String?            @map("avatar_url") @db.VarChar(500)
  bio                String?            @db.VarChar(500)
  headline           String?            @db.VarChar(120)
  joiningYear        Int?               @map("joining_year")
  section            String?            @db.VarChar(50)
  // Profile visibility for contact fields (stored in user_private_details)
  contactVisibility  ContactVisibility  @default(CONNECTIONS) @map("contact_visibility")
  isActive           Boolean            @default(true) @map("is_active")
  isBanned           Boolean            @default(false) @map("is_banned")
  bannedAt           DateTime?          @map("banned_at")
  bannedReason       String?            @map("banned_reason") @db.VarChar(500)
  lastSeenAt         DateTime?          @map("last_seen_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  campus        Campus? @relation(fields: [campusId], references: [id])
  managedCampus Campus? @relation("CampusManager", fields: [managedCampusId], references: [id])

  // Auth (one-to-one)
  authCredential  AuthCredential?
  userCredentials UserCredentials?

  // Social graph
  sentConnections     Connection[] @relation("ConnectionSender")
  receivedConnections Connection[] @relation("ConnectionReceiver")
  following           UserFollow[] @relation("UserFollowing")
  followers           UserFollow[] @relation("UserFollowers")
  blockedUsers        UserBlock[]  @relation("BlockInitiator")
  blockedByUsers      UserBlock[]  @relation("BlockTarget")

  // Content
  posts    Post[]
  comments Comment[]

  // Club membership
  clubMemberships     ClubMember[]
  clubRoleAssignments ClubRoleAssignment[]

  // Group membership
  groupMemberships GroupMember[]
  ownedGroups      Group[]

  // Achievements
  achievements Achievement[]

  // Market
  marketListings CampusMarketListing[]

  // Notifications
  notifications           Notification[]           @relation("NotificationRecipient")
  triggeredNotifications  Notification[]           @relation("NotificationTrigger")
  notificationPreferences NotificationPreference[]

  // Trust & safety
  reportsSubmitted Report[]        @relation("ReportSubmitter")
  adminAuditLogs   AdminAuditLog[]

  // Polls (creator stored for pseudonymity — never returned in API responses)
  pollEntries     PollEntry[]
  pollSubmissions PollSubmission[]

  // Plan Delta v3 relations
  studentAcademicDetails       StudentAcademicDetails?
  facultyDetails               FacultyDetails?
  alumniDetails                AlumniDetails?
  profileLinks                 ProfileLink[]
  companyRoles                 UserCompanyRole[]
  openSourceProjects           OpenSourceProject[]
  followedCompanies            CompanyFollow[]
  followedProjects             ProjectFollow[]
  projectMemberships           ProjectMember[]
  createdOpportunities         InitiativeOpportunity[]
  initiativeInterestRequests   InitiativeInterestRequest[]
  organizedEvents              PlatformEvent[]
  createdInvites               ProfessionalInvite[]    @relation("CreatedInvites")
  receivedInvites              ProfessionalInvite[]    @relation("ReceivedInvites")
  usefulResources              UsefulResource[]
  postLikes                    PostLike[]
  postViews                    PostView[]
  postComments                 PostComment[]
  groupJoinRequests            GroupJoinRequest[]
  feedImpressions              FeedImpression[]
  authorEngagementStats        AuthorEngagementStats?
  userAuthorAffinitiesAsViewer UserAuthorAffinity[]    @relation("UserAffinityViewer")
  userAuthorAffinitiesAsAuthor UserAuthorAffinity[]    @relation("UserAffinityAuthor")

  @@index([campusId])
  @@index([username])
  @@index([role])
  @@index([verificationStatus])
  @@map("user_identity")
}

// SECURITY: admin_service_role has NO SELECT/INSERT/UPDATE/DELETE on this table.
// Applied via packages/db/scripts/apply-security-boundaries.ts after migration.
model UserPrivateDetails {
  userId            String    @id @map("user_id")
  // Registration email — used for auth and domain verification
  email             String    @unique @db.VarChar(254)
  // Personal contact — visibility governed by user_identity.contact_visibility
  whatsappNumber    String?   @map("whatsapp_number") @db.VarChar(20)
  personalEmail     String?   @map("personal_email") @db.VarChar(254)
  professionalEmail String?   @map("professional_email") @db.VarChar(254)
  // MFA
  totpSecret        String?   @map("totp_secret") @db.VarChar(100)
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@map("user_private_details")
}

// Auth sessions & tokens — also off-limits to admin_service_role
model AuthCredential {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  // Argon2id hash — NEVER plain text or bcrypt
  passwordHash   String    @map("password_hash") @db.VarChar(200)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

// Local password, isolated from user_identity on purpose (Argon2id)
model UserCredentials {
  userId              String    @id @map("user_id")
  passwordHash        String    @map("password_hash") @db.VarChar(200)
  passwordSetAt       DateTime  @default(now()) @map("password_set_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  // Rotating refresh token — stored as httpOnly cookie, never in localStorage
  tokenHash String    @unique @map("token_hash") @db.VarChar(200)
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("auth_sessions")
}

// ─────────────────────────────────────────────
// 3. SOCIAL GRAPH
// ─────────────────────────────────────────────

model Connection {
  id         String           @id @default(cuid())
  senderId   String           @map("sender_id")
  receiverId String           @map("receiver_id")
  status     ConnectionStatus @default(PENDING)
  message    String?          @db.VarChar(300)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  sender   UserIdentity @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver UserIdentity @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("connections")
}

// Asymmetric LinkedIn-style Follow relationship (one-way interest, no approval needed)
// Distinct from two-way Connections; primary signal for personalized ML feed/poll ranking.
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  source      String?  @db.VarChar(50) // PROFILE | FEED | SEARCH | NETWORK
  createdAt   DateTime @default(now()) @map("created_at")

  follower  UserIdentity @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following UserIdentity @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt(sort: Desc)])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("user_follows")
}

model UserBlock {
  id          String   @id @default(cuid())
  initiatorId String   @map("initiator_id")
  targetId    String   @map("target_id")
  reason      String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  initiator UserIdentity @relation("BlockInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  target    UserIdentity @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, targetId])
  @@index([targetId])
  @@map("user_blocks")
}

// ─────────────────────────────────────────────
// 4. POSTS, GROUPS, GROUP MEMBERS
// ─────────────────────────────────────────────

model Post {
  id                    String         @id @default(cuid())
  authorId              String         @map("author_id")
  clubId                String?        @map("club_id")
  groupId               String?        @map("group_id")
  companyId             String?        @map("company_id")
  openSourceProjectId   String?        @map("open_source_project_id")
  type                  PostType       @default(TEXT)
  visibility            PostVisibility @default(PUBLIC)
  body                  String?        @db.Text // sanitized server-side before storage
  linkUrl               String?        @map("link_url") @db.VarChar(2000)
  linkPreviewJson       Json?          @map("link_preview_json")
  imageUrls             String[]       @map("image_urls")
  // Orphan flag — set when Club Manager role is revoked (Admin spec delta)
  isOrphaned            Boolean        @default(false) @map("is_orphaned")
  orphanedAt            DateTime?      @map("orphaned_at")
  orphanedByRoleRemoval Boolean        @default(false) @map("orphaned_by_role_removal")
  isPinned              Boolean        @default(false) @map("is_pinned")
  isHidden              Boolean        @default(false) @map("is_hidden")
  hiddenReason          String?        @map("hidden_reason") @db.VarChar(300)
  likeCount             Int            @default(0) @map("like_count")
  commentCount          Int            @default(0) @map("comment_count")
  viewCount             Int            @default(0) @map("view_count")
  targetConnectionScope String         @default("ALL") @map("target_connection_scope")
  targetRoles           String[]       @default(["STUDENT", "FACULTY", "ALUMNI"]) @map("target_roles")
  batch                 String?        @db.VarChar(50)
  isAnonymous           Boolean        @default(false) @map("is_anonymous")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  author            UserIdentity       @relation(fields: [authorId], references: [id])
  club              Club?              @relation(fields: [clubId], references: [id])
  group             Group?             @relation(fields: [groupId], references: [id])
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  openSourceProject OpenSourceProject? @relation(fields: [openSourceProjectId], references: [id], onDelete: SetNull)
  comments          Comment[]
  poll              Poll?
  reports           Report[]
  postLikes         PostLike[]
  postViews         PostView[]
  threadComments    PostComment[]
  feedImpressions   FeedImpression[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([clubId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([openSourceProjectId, createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  authorId  String    @map("author_id")
  parentId  String?   @map("parent_id") // for nested replies (1 level)
  body      String    @db.VarChar(2000) // sanitized server-side
  isHidden  Boolean   @default(false) @map("is_hidden")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  UserIdentity @relation(fields: [authorId], references: [id])
  parent  Comment?     @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]    @relation("CommentReplies")
  reports Report[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Poll {
  id                    String             @id @default(cuid())
  postId                String             @unique @map("post_id")
  question              String             @db.VarChar(500)
  // Pseudonymous: creator_id stored on PollEntry / Post for audit & ML, never exposed when anonymous
  isAnonymous           Boolean            @default(true) @map("is_anonymous")
  allowMultipleAnswers  Boolean            @default(false) @map("allow_multiple_answers")
  submissionMode        PollSubmissionMode @default(SINGLE_SUBMIT) @map("submission_mode")
  geoScope              String             @default("ALL") @map("geo_scope") @db.VarChar(50)
  scopeLabel            String             @default("All Campuses") @map("scope_label") @db.VarChar(150)
  campusId              String?            @map("campus_id")
  targetConnectionScope String             @default("ALL") @map("target_connection_scope")
  targetRoles           String[]           @default(["STUDENT", "FACULTY", "ALUMNI"]) @map("target_roles")
  closesAt              DateTime?          @map("closes_at")
  pollType              String             @default("GENERAL") @map("poll_type") @db.VarChar(20)
  complaintLevel        String?            @map("complaint_level") @db.VarChar(20)
  section               String?            @db.VarChar(50)
  batch                 String?            @db.VarChar(50)
  autoDeleteOnExpire    Boolean            @default(false) @map("auto_delete_on_expire")
  deletedAt             DateTime?          @map("deleted_at")
  createdAt             DateTime           @default(now()) @map("created_at")

  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  campus      Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  options     PollOption[]
  entries     PollEntry[]
  submissions PollSubmission[]

  @@index([createdAt(sort: Desc)])
  @@index([geoScope, campusId])
  @@map("polls")
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String @map("poll_id")
  text      String @db.VarChar(200)
  sortOrder Int    @default(0) @map("sort_order")

  poll    Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  entries PollEntry[]

  @@index([pollId])
  @@map("poll_options")
}

// creator_id is the pseudonymous identifier — NEVER returned in public poll breakdown responses
model PollEntry {
  id        String   @id @default(cuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  // Stored for deduplication & future ML relevance modeling; never exposed as voter identity
  creatorId String   @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at")

  poll    Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option  PollOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  creator UserIdentity @relation(fields: [creatorId], references: [id])

  @@unique([optionId, creatorId])
  @@index([pollId, creatorId])
  @@index([creatorId, createdAt(sort: Desc)])
  @@map("poll_entries")
}

// Tracks completed submission state per (poll, user) so SINGLE_SUBMIT polls are locked at DB level
model PollSubmission {
  id          String   @id @default(cuid())
  pollId      String   @map("poll_id")
  userId      String   @map("user_id")
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  poll Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([userId, submittedAt(sort: Desc)])
  @@map("poll_submissions")
}

model Group {
  id              String    @id @default(cuid())
  ownerId         String    @map("owner_id")
  name            String    @db.VarChar(200)
  slug            String    @unique @db.VarChar(100)
  shortCode       String?   @unique @map("short_code") @db.VarChar(50)
  description     String?   @db.VarChar(1000)
  externalLinkUrl String?   @map("external_link_url") @db.VarChar(2000)
  type            GroupType @default(OPEN)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  memberCount     Int       @default(1) @map("member_count")
  hideMembers     Boolean   @default(false) @map("hide_members")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner        UserIdentity       @relation(fields: [ownerId], references: [id])
  members      GroupMember[]
  posts        Post[]
  joinRequests GroupJoinRequest[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(cuid())
  groupId  String          @map("group_id")
  userId   String          @map("user_id")
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")

  group Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ─────────────────────────────────────────────
// 5. ACHIEVEMENTS, RANKINGS, BRAVE METRICS
// ─────────────────────────────────────────────

model Achievement {
  id                 String                        @id @default(cuid())
  userId             String                        @map("user_id")
  title              String                        @db.VarChar(200)
  description        String?                       @db.VarChar(1000)
  category           AchievementCategory
  scope              AchievementScope
  platform           String?                       @db.VarChar(100) // e.g. "Codeforces", "GitHub"
  proofUrl           String?                       @map("proof_url") @db.VarChar(2000)
  proofDocumentUrl   String?                       @map("proof_document_url") @db.VarChar(2000)
  achievedAt         DateTime                      @map("achieved_at") @db.Date
  verificationStatus AchievementVerificationStatus @default(PENDING) @map("verification_status")
  verifiedById       String?                       @map("verified_by_id")
  verifiedAt         DateTime?                     @map("verified_at")
  rejectionReason    String?                       @map("rejection_reason") @db.VarChar(500)
  // Synced from external APIs (Codeforces rating, LeetCode solved count, etc.)
  externalScore      Int?                          @map("external_score")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  user     UserIdentity         @relation(fields: [userId], references: [id])
  rankings AchievementRanking[]

  @@index([userId, verificationStatus])
  @@index([category, scope])
  @@map("achievements")
}

// Scoped ranking: a student can hold different ranks at CAMPUS / NATIONAL / etc.
// for the same achievement category — stored separately per scope.
model AchievementRanking {
  id            String              @id @default(cuid())
  achievementId String              @map("achievement_id")
  userId        String              @map("user_id")
  campusId      String?             @map("campus_id") // null = global/national scope
  scope         AchievementScope
  category      AchievementCategory
  rank          Int
  score         Float               @default(0)
  computedAt    DateTime            @default(now()) @map("computed_at")

  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([achievementId, scope, campusId])
  @@index([campusId, scope, category, rank])
  @@index([userId, scope])
  @@map("achievement_rankings")
}

// Brave metrics: auto-synced from external platforms via BullMQ workers (Phase 8)
model BraveMetric {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  platform     String   @db.VarChar(50) // "codeforces" | "leetcode" | "github" | "huggingface" | "kaggle"
  metricKey    String   @map("metric_key") @db.VarChar(100) // e.g. "rating", "problems_solved", "stars"
  metricValue  Float    @map("metric_value")
  rawJson      Json?    @map("raw_json")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  syncError    String?  @map("sync_error") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, platform, metricKey])
  @@index([userId, platform])
  @@map("brave_metrics")
}

// ─────────────────────────────────────────────
// 6. CLUBS GOVERNANCE
// ─────────────────────────────────────────────

model ClubMember {
  id       String         @id @default(cuid())
  clubId   String         @map("club_id")
  userId   String         @map("user_id")
  role     ClubMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at")
  isActive Boolean        @default(true) @map("is_active")

  club Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId, role])
  @@map("club_members")
}

// Append-only history log for role changes — supports orphaned-content audit
model ClubRoleAssignment {
  id                String         @id @default(cuid())
  clubId            String         @map("club_id")
  userId            String         @map("user_id")
  role              ClubMemberRole
  assignedById      String         @map("assigned_by_id")
  revokedAt         DateTime?      @map("revoked_at")
  revokedById       String?        @map("revoked_by_id")
  // When revoked, their content is flagged orphaned — not deleted
  contentOrphanedAt DateTime?      @map("content_orphaned_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  club Club         @relation(fields: [clubId], references: [id])
  user UserIdentity @relation(fields: [userId], references: [id])

  @@index([clubId, userId])
  @@index([userId, revokedAt])
  @@map("club_role_assignments")
}

model SuggestionWindow {
  id          String   @id @default(cuid())
  clubId      String   @map("club_id")
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  opensAt     DateTime @map("opens_at")
  closesAt    DateTime @map("closes_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  club        Club         @relation(fields: [clubId], references: [id])
  suggestions Suggestion[]

  @@index([clubId, isActive])
  @@map("suggestion_windows")
}

model Suggestion {
  id              String    @id @default(cuid())
  windowId        String    @map("window_id")
  authorId        String    @map("author_id")
  title           String    @db.VarChar(200)
  body            String    @db.Text
  voteCount       Int       @default(0) @map("vote_count")
  isImplemented   Boolean   @default(false) @map("is_implemented")
  implementedAt   DateTime? @map("implemented_at")
  implementedNote String?   @map("implemented_note") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  window SuggestionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  votes  SuggestionVote[]

  @@index([windowId, voteCount(sort: Desc)])
  @@map("suggestions")
}

// One changeable vote per voter per window (enforced by unique constraint on windowId+voterId)
model SuggestionVote {
  id           String   @id @default(cuid())
  suggestionId String   @map("suggestion_id")
  windowId     String   @map("window_id") // denormalised for the unique constraint
  voterId      String   @map("voter_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([windowId, voterId]) // one changeable vote per window
  @@index([suggestionId])
  @@map("suggestion_votes")
}

