model Notification {
  id            String           @id @default(cuid())
  recipientId   String           @map("recipient_id")
  triggeredById String?          @map("triggered_by_id")
  type          NotificationType
  title         String           @db.VarChar(200)
  body          String?          @db.VarChar(500)
  actionUrl     String?          @map("action_url") @db.VarChar(500)
  isRead        Boolean          @default(false) @map("is_read")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  recipient   UserIdentity  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  triggeredBy UserIdentity? @relation("NotificationTrigger", fields: [triggeredById], references: [id])

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  inApp     Boolean          @default(true) @map("in_app")
  email     Boolean          @default(false)
  updatedAt DateTime         @updatedAt @map("updated_at")

  user UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
// 10. TRUST & SAFETY / ADMIN
// ─────────────────────────────────────────────

model Report {
  id             String            @id @default(cuid())
  submitterId    String            @map("submitter_id")
  contentType    ReportContentType @map("content_type")
  // Polymorphic references — use content_type to know which table to join
  postId         String?           @map("post_id")
  commentId      String?           @map("comment_id")
  listingId      String?           @map("listing_id")
  reportedUserId String?           @map("reported_user_id")
  reason         String            @db.VarChar(100)
  details        String?           @db.VarChar(1000)
  status         ReportStatus      @default(OPEN)
  reviewedById   String?           @map("reviewed_by_id")
  reviewedAt     DateTime?         @map("reviewed_at")
  resolution     String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  submitter UserIdentity         @relation("ReportSubmitter", fields: [submitterId], references: [id])
  post      Post?                @relation(fields: [postId], references: [id])
  comment   Comment?             @relation(fields: [commentId], references: [id])
  listing   CampusMarketListing? @relation(fields: [listingId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([submitterId])
  @@map("reports")
}

model DataDeletionRequest {
  id           String                @id @default(cuid())
  userId       String                @map("user_id")
  status       DeletionRequestStatus @default(PENDING)
  requestedAt  DateTime              @default(now()) @map("requested_at")
  scheduledAt  DateTime?             @map("scheduled_at")
  completedAt  DateTime?             @map("completed_at")
  reviewedById String?               @map("reviewed_by_id")
  notes        String?               @db.VarChar(500)

  @@index([userId])
  @@index([status])
  @@map("data_deletion_requests")
}

// Pending bulk/destructive admin actions — typed-confirmation + revert-window pattern
model PendingBulkAction {
  id               String         @id @default(cuid())
  initiatedById    String         @map("initiated_by_id")
  type             BulkActionType
  // JSON payload describing the action (user IDs, post IDs, etc.)
  payload          Json
  // Typed confirmation text the admin must have entered
  confirmationText String         @map("confirmation_text") @db.VarChar(200)
  // Revert window: action is reversible until this timestamp
  revertableUntil  DateTime       @map("revertable_until")
  executedAt       DateTime?      @map("executed_at")
  revertedAt       DateTime?      @map("reverted_at")
  revertedById     String?        @map("reverted_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([initiatedById])
  @@index([executedAt, revertableUntil])
  @@map("pending_bulk_actions")
}

// Append-only at DB level: admin_service_role has INSERT only, no UPDATE/DELETE
// Enforced by apply-security-boundaries.ts
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String   @db.VarChar(100) // e.g. "VERIFY_ACHIEVEMENT", "BAN_USER"
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String   @map("target_id")
  // Structured log payload — no PII logged, only IDs
  metaJson   Json?    @map("meta_json")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  admin UserIdentity @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────
