model CampusMarketListing {
  id          String                 @id @default(cuid())
  campusId    String                 @map("campus_id")
  sellerId    String                 @map("seller_id")
  title       String                 @db.VarChar(200)
  description String                 @db.Text
  priceInr    Decimal                @map("price_inr") @db.Decimal(10, 2)
  condition   MarketListingCondition @default(GOOD)
  status      MarketListingStatus    @default(ACTIVE)
  // Flagged listings held from public view until Admin action (plan rule)
  flaggedAt   DateTime?              @map("flagged_at")
  flagReason  String?                @map("flag_reason") @db.VarChar(500)
  soldAt      DateTime?              @map("sold_at")
  viewCount   Int                    @default(0) @map("view_count")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  campus      Campus              @relation(fields: [campusId], references: [id])
  seller      UserIdentity        @relation(fields: [sellerId], references: [id])
  images      CampusMarketImage[]
  reports     Report[]

  @@index([campusId, status, createdAt(sort: Desc)])
  @@index([sellerId])
  @@map("campus_market_listings")
}

model CampusMarketImage {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  url       String   @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing   CampusMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("campus_market_images")
}

