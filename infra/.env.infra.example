# Infrastructure-level secrets for docker-compose
# Copy to infra/.env.infra and fill in real values — NEVER commit the real file.

POSTGRES_OWNER_PASSWORD=localdevonly_CHANGE_ME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_CHANGE_ME

# Runtime role passwords (used by apps; keep different from owner password)
APP_SERVICE_ROLE_PASSWORD=app_localdev_CHANGE_ME
ADMIN_SERVICE_ROLE_PASSWORD=admin_localdev_CHANGE_ME
